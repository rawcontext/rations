{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!!docs", "!!**/migrations/meta", "!!MODULE.bazel.lock", "!!pnpm-lock.yaml"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 50 } }
      },
      "style": {
        "noExcessiveClassesPerFile": { "level": "error", "options": { "maxClasses": 1 } },
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 350 } }
      }
    }
  }
}
