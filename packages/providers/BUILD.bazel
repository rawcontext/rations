load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

package(default_visibility = ["//visibility:private"])

swift_library(
    name = "lib",
    srcs = glob(["Sources/*.swift"]),
    copts = [
        "-swift-version",
        "6",
    ],
    module_name = "RationsProviders",
    visibility = ["//apps:__subpackages__"],
    deps = ["//packages/core:lib"],
)

swift_test(
    name = "test",
    size = "small",
    srcs = glob(["Tests/*.swift"]),
    visibility = ["//:__pkg__"],
    deps = [
        ":lib",
        "//packages/core:lib",
    ],
)
