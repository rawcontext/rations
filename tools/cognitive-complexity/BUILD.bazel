load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_library", "swift_test")

swift_library(
    name = "lib",
    srcs = [
        "Sources/CognitiveComplexity.swift",
        "Sources/ComplexityVisitor.swift",
    ],
    module_name = "CognitiveLint",
    deps = ["@swift-syntax//:SwiftSyntax"],
)

swift_binary(
    name = "check",
    srcs = ["Sources/main.swift"],
    deps = [
        ":lib",
        "@swift-syntax//:SwiftParser",
    ],
)

swift_test(
    name = "test",
    size = "small",
    srcs = ["Tests/CognitiveComplexityTests.swift"],
    visibility = ["//:__pkg__"],
    deps = [
        ":lib",
        "@swift-syntax//:SwiftParser",
        "@swift-syntax//:SwiftSyntax",
    ],
)
