{
  "name": "rations",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "prepare": "lefthook install",
    "build": "bazel build //apps/... //packages/...",
    "test": "bazel test //...",
    "lint": "bash scripts/lint.sh",
    "check": "pnpm run lint && pnpm run build && pnpm test",
    "dev": "./scripts/build_and_run.sh",
    "xcode": "bazel run //apps/macos:xcodeproj",
    "release:prepare": "python3 tools/release/release.py prepare",
    "release": "python3 tools/release/release.py release",
    "release:publish": "python3 tools/release/release.py publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "jscpd": "5.2.0",
    "lefthook": "2.1.12",
    "pnpm": "12.4.1"
  }
}
